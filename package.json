{
  "name": "vscode-sentry-plugin",
  "displayName": "Sentry Error Reporter",
  "description": "Shows inline reporting of how often an error is reported to Sentry",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:python",
    "onLanguage:java"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sentry-plugin.refreshErrors",
        "title": "Refresh Sentry Error Data"
      }
    ],
    "configuration": {
      "title": "Sentry Plugin",
      "properties": {
        "sentryPlugin.authToken": {
          "type": "string",
          "default": "",
          "description": "Sentry API authentication token"
        },
        "sentryPlugin.organization": {
          "type": "string",
          "default": "",
          "description": "Sentry organization slug"
        },
        "sentryPlugin.project": {
          "type": "string",
          "default": "",
          "description": "Sentry project slug"
        },
        "sentryPlugin.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable/disable the Sentry plugin"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}